# Local-only Supabase development template for Butcher Block Steakhouse.
# Copy to `.env.local` ONLY when running `npm run db:start` locally.
# NEVER commit `.env.local` or paste production service-role keys into browser VITE_* variables.

VITE_SUPABASE_URL="http://127.0.0.1:54321"
# Standard local Supabase CLI demo anon key (printed by `supabase status`; valid ONLY for local Docker)
VITE_SUPABASE_PUBLISHABLE_KEY="replace-with-local-anon-key-from-supabase-status"
VITE_SUPABASE_PROJECT_ID="local-butcher-block"

# Keep strict schema & RPC enforcement enabled (never silently strip fields or bypass transition RPCs)
VITE_ALLOW_LEGACY_SCHEMA_FALLBACK="false"

# Optional: local-only dev admin email allowlist (ignored in production builds)
VITE_DEV_ADMIN_EMAILS="admin.test@butcherblock.local"
